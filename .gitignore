# API 金鑰（絕對不能上傳）
.env

# Python 虛擬環境（太大，不需要上傳）
venv/

# Python 快取
__pycache__/
*.pyc
*.pyo

# 執行紀錄（logs/app.log 累積檔，不版控）
logs/
*.log

# 暫存音訊檔
temp_seg_*.mp3

# 輸出的字幕檔（個人使用，不需版控）
*.srt

# GUI 設定檔（本機主題偏好）
.tool_config.json

# 可續跑的字幕工作進度（影片旁的本機暫存資料）
*.subtitler.resume.json
.subtitler_resume_index.json
